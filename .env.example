# Pick any provider; the code is the same for all of them.
# Providers: openai | gemini | groq | openrouter | anthropic | ollama | custom
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini

# Only the key for your chosen provider is needed
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# For provider=custom (any OpenAI-compatible endpoint, e.g. one Kuku provides)
LLM_BASE_URL=
LLM_API_KEY=

# Web app (optional): set ACCESS_CODE to let only people with the code use the key above.
# Leave it out and anyone with the link can run the site on your key.
ACCESS_CODE=
